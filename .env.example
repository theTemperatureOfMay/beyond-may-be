# 로컬 PostgreSQL 예시 값입니다. 실제 비밀값을 기록하지 마세요.
DB_NAME=beyond_may_be
DB_USERNAME=postgres
DB_PASSWORD=local-only-password
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/beyond_may_be

# 한국관광공사 TourAPI 변경분 조회. 로컬·운영 인증키 모두 Decoding 값을 사용하세요.
# 로컬 키는 .env에만, 운영 키는 terraform/README.md 절차로 관리하세요.
TOURISM_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOURISM_API_KEY=
TOURISM_POPULARITY_API_BASE_URL=

# Groq 장소 선별. 로컬 키는 .env에만 기록하세요.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq API (무료 티어) - https://console.groq.com 에서 발급. 비워두면 AI 코스 생성은
# 알고리즘 기반 휴리스틱으로 자동 폴백한다.
GROQ_API_KEY=
